{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cle1"
  ],
  "crons": [
    {
      "path": "/api/run-pipeline",
      "schedule": "30 2 * * 1,4"
    },
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "app/api/run-pipeline/route.ts": {
      "maxDuration": 300
    },
    "app/api/run-now/route.ts": {
      "maxDuration": 300
    }
  }
}
