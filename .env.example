# Gemini (all runtime AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Neon Postgres
APP_DATABASE_URL=          # vc_runtime role (app runtime; no UPDATE/DELETE on vcs)
DATABASE_URL=              # owner, pooled; written by `neon link` (not used by the app)
DATABASE_URL_UNPOOLED=     # owner, direct; migrations only (never set on Vercel)


# Route protection
CRON_SECRET=

# Data sources
EXA_API_KEY=
TAVILY_API_KEY=
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
YOUTUBE_API_KEY=
SEC_USER_AGENT="VCPipelineIntelligence contact@example.com"

# Optional (v2)
X_BEARER_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
JINA_API_KEY=
