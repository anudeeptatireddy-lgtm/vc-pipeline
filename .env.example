# Wrap any value that contains a # in double quotes, e.g. KEY="abc#123";
# otherwise everything after the # is treated as a comment and cut off.

# Gemini (all runtime AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Neon Postgres
APP_DATABASE_URL=          # vc_runtime role (scan, Run now; no INSERT/UPDATE/DELETE on vcs)
APP_READONLY_DATABASE_URL= # vc_web role (dashboard pages; SELECT only)
DATABASE_URL=              # owner, pooled; written by `neon link` (not used by the app)
DATABASE_URL_UNPOOLED=     # owner, direct; migrations only (never set on Vercel)


# Route protection
CRON_SECRET=

# Data sources
EXA_API_KEY=
TAVILY_API_KEY=
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
YOUTUBE_API_KEY=
SEC_USER_AGENT="VCPipelineIntelligence contact@example.com"

# Optional (v2)
X_BEARER_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
JINA_API_KEY=
